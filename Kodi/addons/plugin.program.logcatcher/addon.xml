<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.logcatcher"
       name="Log Catcher"
       version="1.0.0"
       provider-name="Eric">

    <requires>
        <import addon="xbmc.python" version="3.0.1" />
    </requires>

    <!-- Main entry point -->
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>

    <!-- Background service -->
    <extension point="xbmc.service" library="service.py" start="startup" />

    <!-- Metadata -->
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Capture URLs from kodi.log in real time</summary>
        <description lang="en_GB">
            Monitors kodi.log for streaming URLs, filters them, displays them,
            and optionally sends them to Aria2.
        </description>
        <disclaimer lang="en_GB">This addon contains no content.</disclaimer>

        <language>en</language>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>

        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>

</addon>
