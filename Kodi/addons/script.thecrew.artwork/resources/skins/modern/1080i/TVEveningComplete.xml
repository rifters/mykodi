<?xml version="1.0" encoding="UTF-8"?>
<window>
    <animation effect="fade" time="300">WindowOpen</animation>
    <animation effect="fade" time="300">WindowClose</animation>

    <controls>
        <!-- Full screen background with fanart -->
        <control type="image">
            <description>Background Fanart</description>
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window().Property(fanart)]</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Dark overlay for readability -->
        <control type="image">
            <description>Dark Overlay</description>
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="DD000000">white.png</texture>
        </control>

        <!-- Main content container -->
        <control type="group">
            <left>460</left>
            <top>300</top>

            <!-- The Crew Logo -->
            <control type="image">
                <description>The Crew Logo</description>
                <left>350</left>
                <top>0</top>
                <width>300</width>
                <height>100</height>
                <texture>icon.png</texture>
                <aspectratio aligny="center">keep</aspectratio>
            </control>

            <!-- Completion Message -->
            <control type="label" id="9001">
                <description>Completion Message</description>
                <left>0</left>
                <top>150</top>
                <width>1000</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>FFEDC8FF</textcolor>
                <align>center</align>
                <label>You've watched The Crew's TV Evening Playlist</label>
            </control>

            <!-- Time-based Greeting -->
            <control type="label" id="9002">
                <description>Greeting Message</description>
                <left>0</left>
                <top>220</top>
                <width>1000</width>
                <height>40</height>
                <font>font16</font>
                <textcolor>FFAAAAAA</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(greeting)]</label>
            </control>

            <!-- Stats -->
            <control type="label" id="9003">
                <description>Episodes Watched</description>
                <left>0</left>
                <top>280</top>
                <width>1000</width>
                <height>35</height>
                <font>font13</font>
                <textcolor>FF888888</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(stats)]</label>
            </control>

            <!-- Countdown Timer -->
            <control type="label" id="9004">
                <description>Auto-close Timer</description>
                <left>0</left>
                <top>350</top>
                <width>1000</width>
                <height>30</height>
                <font>font12</font>
                <textcolor>FF666666</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(timer)]</label>
            </control>

            <!-- Close Button -->
            <control type="button" id="5">
                <description>Close</description>
                <left>365</left>
                <top>420</top>
                <width>270</width>
                <height>60</height>
                <label>CLOSE</label>
                <font>font14</font>
                <textcolor>FF000000</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus colordiffuse="FFEDC8FF" border="5">white.png</texturefocus>
                <texturenofocus colordiffuse="88888888" border="5">white.png</texturenofocus>
                <onup>5</onup>
                <ondown>5</ondown>
                <onleft>5</onleft>
                <onright>5</onright>
            </control>
        </control>
    </controls>
</window>
