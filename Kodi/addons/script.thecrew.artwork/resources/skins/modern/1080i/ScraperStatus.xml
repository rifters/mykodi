<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">5000</defaultcontrol>
    <controls>
        <!-- Modern Fanart Background (like other dialogs) -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(fanart)]</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Dark overlay for readability -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="DD000000">white.png</texture>
        </control>

        <!-- Glassy gradient effect (modern style) -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="40FFFFFF">gradient.png</texture>
        </control>

        <!-- Header -->
        <control type="grouplist" id="1000">
            <posx>100</posx>
            <posy>60</posy>
            <width>1720</width>
            <height>140</height>
            <orientation>vertical</orientation>
            <itemgap>10</itemgap>

            <!-- Title -->
            <control type="label">
                <width>1720</width>
                <height>50</height>
                <font>font35_title</font>
                <textcolor>FFE0B0FF</textcolor>
                <label>[COLOR orchid]THE CREW[/COLOR] - Scraper Status</label>
                <align>center</align>
            </control>

            <!-- Summary Info -->
            <control type="label" id="2">
                <width>1720</width>
                <height>30</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(summary)]</label>
                <align>center</align>
            </control>

            <!-- Last Updated -->
            <control type="label" id="3">
                <width>1720</width>
                <height>35</height>
                <font>font12</font>
                <textcolor>FFAAAAAA</textcolor>
                <label>Last Tested: $INFO[Window.Property(last_updated)]</label>
                <align>center</align>
            </control>
        </control>

        <!-- Category Tabs -->
        <control type="grouplist" id="3000">
            <posx>100</posx>
            <posy>210</posy>
            <width>1720</width>
            <height>50</height>
            <orientation>horizontal</orientation>
            <itemgap>20</itemgap>
            <align>center</align>

            <control type="radiobutton" id="3001">
                <width>350</width>
                <height>50</height>
                <font>font13</font>
                <label>Direct Sources</label>
                <radioposx>15</radioposx>
                <textoffsetx>105</textoffsetx>
                <textwidth>230</textwidth>
                <onclick>SetProperty(category,direct)</onclick>
                <onclick>Control.SetFocus(5000)</onclick>
            </control>

            <control type="radiobutton" id="3002">
                <width>350</width>
                <height>50</height>
                <font>font13</font>
                <label>Torrent Sources</label>
                <radioposx>15</radioposx>
                <textoffsetx>105</textoffsetx>
                <textwidth>230</textwidth>
                <onclick>SetProperty(category,torrent)</onclick>
                <onclick>Control.SetFocus(5000)</onclick>
            </control>

            <control type="radiobutton" id="3003">
                <width>350</width>
                <height>50</height>
                <font>font13</font>
                <label>Usenet Sources</label>
                <radioposx>15</radioposx>
                <textoffsetx>105</textoffsetx>
                <textwidth>230</textwidth>
                <onclick>SetProperty(category,usenet)</onclick>
                <onclick>Control.SetFocus(5000)</onclick>
            </control>
        </control>

        <!-- Scrapers List -->
        <control type="panel" id="5000">
            <posx>100</posx>
            <posy>290</posy>
            <width>1720</width>
            <height>690</height>
            <onup>3001</onup>
            <ondown>8000</ondown>
            <pagecontrol>61</pagecontrol>
            <scrolltime tween="cubic" easing="out">200</scrolltime>
            <orientation>vertical</orientation>
            <itemlayout height="70" width="860">
                <control type="image">
                    <posx>0</posx>
                    <posy>0</posy>
                    <width>840</width>
                    <height>65</height>
                    <texture border="5">white.png</texture>
                    <colordiffuse>30FFFFFF</colordiffuse>
                </control>

                <!-- Status Icon -->
                <control type="image">
                    <posx>20</posx>
                    <posy>17</posy>
                    <width>30</width>
                    <height>30</height>
                    <texture>$INFO[ListItem.Property(status_icon)]</texture>
                    <aspectratio>keep</aspectratio>
                </control>

                <!-- Scraper Name -->
                <control type="label">
                    <posx>70</posx>
                    <posy>5</posy>
                    <width>500</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>

                <!-- Status Text -->
                <control type="label">
                    <posx>70</posx>
                    <posy>35</posy>
                    <width>500</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>$INFO[ListItem.Property(status_color)]</textcolor>
                    <label>$INFO[ListItem.Property(status)]</label>
                </control>

                <!-- Pack Capable Badge -->
                <control type="label">
                    <posx>600</posx>
                    <posy>20</posy>
                    <width>80</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>$INFO[ListItem.Property(status_color)]</textcolor>
                    <label>$INFO[ListItem.Property(pack_badge)]</label>
                    <visible>String.IsEqual(ListItem.Property(pack_capable),true)</visible>
                </control>

                <!-- Response Time -->
                <control type="label">
                    <posx>700</posx>
                    <posy>20</posy>
                    <width>120</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>FFAAAAAA</textcolor>
                    <label>$INFO[ListItem.Property(response_time)]</label>
                    <align>right</align>
                </control>
            </itemlayout>

            <focusedlayout height="70" width="860">
                <control type="image">
                    <posx>0</posx>
                    <posy>0</posy>
                    <width>840</width>
                    <height>65</height>
                    <texture border="5">white.png</texture>
                    <colordiffuse>FFE0B0FF</colordiffuse>
                    <animation effect="fade" start="100" end="70" time="300" condition="true">Conditional</animation>
                </control>

                <!-- Status Icon -->
                <control type="image">
                    <posx>20</posx>
                    <posy>17</posy>
                    <width>30</width>
                    <height>30</height>
                    <texture>$INFO[ListItem.Property(status_icon)]</texture>
                    <aspectratio>keep</aspectratio>
                </control>

                <!-- Scraper Name -->
                <control type="label">
                    <posx>70</posx>
                    <posy>5</posy>
                    <width>500</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>

                <!-- Status Text -->
                <control type="label">
                    <posx>70</posx>
                    <posy>35</posy>
                    <width>500</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(status)]</label>
                </control>

                <!-- Pack Capable Badge -->
                <control type="label">
                    <posx>600</posx>
                    <posy>20</posy>
                    <width>80</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(pack_badge)]</label>
                    <visible>String.IsEqual(ListItem.Property(pack_capable),true)</visible>
                </control>

                <!-- Response Time -->
                <control type="label">
                    <posx>700</posx>
                    <posy>20</posy>
                    <width>120</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(response_time)]</label>
                    <align>right</align>
                </control>
            </focusedlayout>
        </control>

        <!-- Scrollbar -->
        <control type="scrollbar" id="61">
            <posx>1830</posx>
            <posy>280</posy>
            <width>12</width>
            <height>700</height>
            <texturesliderbackground>-</texturesliderbackground>
            <texturesliderbar>white.png</texturesliderbar>
            <texturesliderbarfocus>white.png</texturesliderbarfocus>
            <textureslidernib>-</textureslidernib>
            <textureslidernibfocus>-</textureslidernibfocus>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <colordiffuse>88FFFFFF</colordiffuse>
        </control>

        <!-- Bottom Buttons -->
        <control type="grouplist" id="8000">
            <posx>100</posx>
            <posy>1000</posy>
            <width>1720</width>
            <height>60</height>
            <orientation>horizontal</orientation>
            <itemgap>20</itemgap>
            <align>center</align>
            <onup>5000</onup>

            <control type="button" id="8001">
                <width>250</width>
                <height>50</height>
                <font>font13</font>
                <label>Refresh Status</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus>white.png</texturefocus>
                <texturenofocus>white.png</texturenofocus>
                <colordiffuse>30FFFFFF</colordiffuse>
                <focusedcolordiffuse>FFE0B0FF</focusedcolordiffuse>
            </control>

            <control type="button" id="8002">
                <width>250</width>
                <height>50</height>
                <font>font13</font>
                <label>Test All Scrapers</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus>white.png</texturefocus>
                <texturenofocus>white.png</texturenofocus>
                <colordiffuse>30FFFFFF</colordiffuse>
                <focusedcolordiffuse>FFE0B0FF</focusedcolordiffuse>
            </control>

            <control type="button" id="8003">
                <width>250</width>
                <height>50</height>
                <font>font13</font>
                <label>Close</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus>white.png</texturefocus>
                <texturenofocus>white.png</texturenofocus>
                <colordiffuse>30FFFFFF</colordiffuse>
                <focusedcolordiffuse>FFE0B0FF</focusedcolordiffuse>
                <onclick>Dialog.Close(all,true)</onclick>
            </control>
        </control>
    </controls>
</window>
