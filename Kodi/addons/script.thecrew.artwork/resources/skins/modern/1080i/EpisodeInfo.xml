<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<coordinates>
		<posx>0</posx>
		<posy>0</posy>
	</coordinates>

	<controls>
		<!-- Background dimmed overlay -->
		<control type="image">
			<posx>0</posx>
			<posy>0</posy>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="DD000000">colors/white.png</texture>
		</control>

		<!-- Dialog container -->
		<control type="group">
			<posx>560</posx>
			<posy>240</posy>
			<width>800</width>
			<height>600</height>

			<!-- Panel background -->
			<control type="image">
				<posx>0</posx>
				<posy>0</posy>
				<width>800</width>
				<height>600</height>
				<texture colordiffuse="EE151515">colors/white.png</texture>
				<bordertexture border="12" colordiffuse="FF333333">colors/white.png</bordertexture>
				<bordersize>2</bordersize>
			</control>

		<!-- Poster Section -->
		<control type="group">
			<posx>40</posx>
			<posy>30</posy>
			<width>200</width>
			<height>300</height>

			<!-- Season Poster -->
			<control type="image">
				<posx>0</posx>
				<posy>0</posy>
				<width>200</width>
				<height>300</height>
				<texture>$INFO[Window.Property(episode_poster)]</texture>
				<aspectratio>scale</aspectratio>
				<bordertexture border="2" colordiffuse="FF333333">colors/white.png</bordertexture>
				<bordersize>1</bordersize>
			</control>
		</control>

		<!-- Info section -->
		<control type="group">
			<posx>260</posx>
			<posy>30</posy>
			<width>500</width>
			<height>540</height>

			<!-- Combined Show Title + Episode (one line) -->
			<control type="label">
				<posx>0</posx>
				<posy>0</posy>
				<width>500</width>
				<height>50</height>
				<font>font30</font>
				<textcolor>FFEDC8FF</textcolor>
				<label>$INFO[Window.Property(show_title)] - $INFO[Window.Property(episode_badge)]</label>
			</control>

			<!-- Episode Title -->
			<control type="label">
				<posx>0</posx>
				<posy>60</posy>
				<width>500</width>
				<height>40</height>
				<font>font14</font>
				<textcolor>FFCCCCCC</textcolor>
				<label>$INFO[Window.Property(episode_title)]</label>
			</control>

			<!-- Runtime -->
			<control type="label">
				<posx>0</posx>
				<posy>105</posy>
				<width>500</width>
				<height>30</height>
				<font>font12</font>
				<textcolor>FF888888</textcolor>
				<label>Runtime: $INFO[Window.Property(runtime)] min</label>
			</control>

			<!-- Plot (scrollable textbox) -->
			<control type="textbox">
				<posx>0</posx>
				<posy>150</posy>
				<width>500</width>
				<height>330</height>
				<font>font13</font>
				<textcolor>FFAAAAAA</textcolor>
				<info>Window.Property(plot)</info>
				<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
			</control>

			<!-- OK Button -->
			<control type="button" id="9000">
				<posx>150</posx>
				<posy>500</posy>
				<width>200</width>
				<height>50</height>
				<font>font14</font>
				<textcolor>FFFFFFFF</textcolor>
				<focusedcolor>FF000000</focusedcolor>
				<label>OK</label>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="FFE0B0FF">colors/white.png</texturefocus>
				<texturenofocus colordiffuse="44FFFFFF">colors/white.png</texturenofocus>
			</control>
		</control>
		</control>
	</controls>
</window>
