<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <animation effect="fade" time="300">WindowOpen</animation>
    <animation effect="fade" time="300">WindowClose</animation>
    <controls>
        <!-- Fullscreen backdrop -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(tvevening.fanart)]</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Dark overlay for glass effect -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="88000000">white.png</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Right panel container -->
        <control type="group" id="9001">
            <posx>1500</posx>
            <posy>0</posy>
            <width>420</width>
            <height>1080</height>

            <!-- Pure black glass background -->
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <width>420</width>
                <height>1080</height>
                <texture colordiffuse="AA000000">white.png</texture>
            </control>

            <!-- The Crew Logo -->
            <control type="image">
                <posx>185</posx>
                <posy>50</posy>
                <width>50</width>
                <height>50</height>
                <texture>special://home/addons/plugin.video.thecrew/icon.png</texture>
                <aspectratio>keep</aspectratio>
            </control>

            <!-- "TV Evening" title text -->
            <control type="label" id="201">
                <posx>20</posx>
                <posy>110</posy>
                <width>380</width>
                <height>50</height>
                <font>font16</font>
                <align>center</align>
                <textcolor>FFE6B8F5</textcolor>
                <label>MY TV EVENING</label>
            </control>

            <!-- Subtitle -->
            <control type="textbox" id="200">
                <posx>30</posx>
                <posy>180</posy>
                <width>360</width>
                <height>80</height>
                <font>font13</font>
                <align>center</align>
                <textcolor>FFCCCCCC</textcolor>
                <label>How long is your TV Evening tonight?</label>
            </control>

            <!-- Duration buttons group -->
            <control type="grouplist" id="9000">
                <posx>30</posx>
                <posy>280</posy>
                <width>360</width>
                <height>600</height>
                <itemgap>15</itemgap>
                <onup>106</onup>
                <ondown>100</ondown>
                <orientation>vertical</orientation>

                <!-- 30 minutes button -->
                <control type="button" id="100">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>30 Minutes</label>
                    <texturefocus colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus colordiffuse="33EDC8FF">white.png</texturenofocus>
                    <onup>106</onup>
                    <ondown>101</ondown>
                </control>

                <!-- 1 hour button -->
                <control type="button" id="101">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>1 Hour</label>
                    <texturefocus colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus colordiffuse="33EDC8FF">white.png</texturenofocus>
                    <onup>100</onup>
                    <ondown>102</ondown>
                </control>

                <!-- 2 hours button -->
                <control type="button" id="102">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>2 Hours</label>
                    <texturefocus colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus colordiffuse="33EDC8FF">white.png</texturenofocus>
                    <onup>101</onup>
                    <ondown>103</ondown>
                </control>

                <!-- 3 hours button -->
                <control type="button" id="103">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>3 Hours</label>
                    <texturefocus colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus colordiffuse="33EDC8FF">white.png</texturenofocus>
                    <onup>102</onup>
                    <ondown>104</ondown>
                </control>

                <!-- 4 hours button -->
                <control type="button" id="104">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>4 Hours</label>
                    <texturefocus colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus colordiffuse="33EDC8FF">white.png</texturenofocus>
                    <onup>103</onup>
                    <ondown>105</ondown>
                </control>

                <!-- Custom duration button -->
                <control type="button" id="105">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>Custom Duration...</label>
                    <texturefocus colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus colordiffuse="33EDC8FF">white.png</texturenofocus>
                    <onup>104</onup>
                    <ondown>106</ondown>
                </control>

                <!-- Cancel button -->
                <control type="button" id="106">
                    <width>360</width>
                    <height>70</height>
                    <font>font14</font>
                    <textcolor>FFAAAAAA</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>Cancel</label>
                    <texturefocus colordiffuse="FFAA5555">white.png</texturefocus>
                    <texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
                    <onup>105</onup>
                    <ondown>100</ondown>
                </control>
            </control>
        </control>

        <!-- Instruction hint at bottom -->
        <control type="label" id="9002">
            <posx>1510</posx>
            <posy>1000</posy>
            <width>400</width>
            <height>40</height>
            <font>font12</font>
            <align>center</align>
            <textcolor>88FFFFFF</textcolor>
            <label>Select duration or press Back to cancel</label>
        </control>

        <!-- CENTER PROGRESS GROUP (for building state) -->
        <control type="group" id="8000">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>

            <!-- Main title - centered fullscreen -->
            <control type="label" id="8001">
                <posx>0</posx>
                <posy>300</posy>
                <width>1920</width>
                <height>80</height>
                <font>font13</font>
                <align>center</align>
                <textcolor>FFEDC8FF</textcolor>
                <label>BUILDING YOUR PLAYLIST</label>
            </control>

            <!-- Progress message - below title, centered fullscreen -->
            <control type="textbox" id="8002">
                <posx>460</posx>
                <posy>420</posy>
                <width>1000</width>
                <height>200</height>
                <font>font13</font>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
                <label>Please wait...</label>
            </control>

            <!-- Progress Bar Container - centered on full 1920px -->
            <control type="group" id="8003">
                <posx>660</posx>
                <posy>550</posy>
                <width>600</width>
                <height>80</height>

                <!-- Progress Bar Background (border) -->
                <control type="image" id="8004">
                    <posx>0</posx>
                    <posy>0</posy>
                    <width>600</width>
                    <height>30</height>
                    <texture border="2" colordiffuse="88FFFFFF">white.png</texture>
                </control>

                <!-- Progress Bar Fill (orchid color, width changes) -->
                <control type="image" id="8005">
                    <posx>2</posx>
                    <posy>2</posy>
                    <width>0</width>
                    <height>26</height>
                    <texture colordiffuse="FFEDC8FF">white.png</texture>
                </control>

                <!-- Percentage Text -->
                <control type="label" id="8006">
                    <posx>0</posx>
                    <posy>40</posy>
                    <width>600</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>FFEDC8FF</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>0%</label>
                </control>
            </control>
        </control>
    </controls>
</window>
