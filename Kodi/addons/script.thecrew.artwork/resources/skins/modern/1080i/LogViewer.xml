<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">201</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
    <coordinates>
        <left>100</left>
        <top>60</top>
    </coordinates>
    <controls>
        <control type="group">
            <!-- Background overlay -->
            <control type="image">
                <description>Background Overlay</description>
                <left>0</left>
                <top>0</top>
                <width>1720</width>
                <height>960</height>
                <texture colordiffuse="F0000000">white.png</texture>
            </control>

            <!-- Glassy band background (like TV Evening) -->
            <control type="image">
                <description>Glassy Background Band</description>
                <left>0</left>
                <top>0</top>
                <width>1720</width>
                <height>960</height>
                <texture colordiffuse="DD000000">white.png</texture>
            </control>

            <!-- Gradient overlay for depth -->
            <control type="image">
                <description>Gradient Overlay</description>
                <left>0</left>
                <top>0</top>
                <width>1720</width>
                <height>960</height>
                <texture colordiffuse="50FFFFFF">gradient.png</texture>
            </control>

            <!-- Header Label -->
            <control type="label" id="101">
                <description>Header Label</description>
                <left>60</left>
                <top>40</top>
                <width>1600</width>
                <height>60</height>
                <font>font30_title</font>
                <label></label>
                <textcolor>orchid</textcolor>
                <align>center</align>
                <aligny>center</aligny>
            </control>

            <!-- Separator line -->
            <control type="image">
                <description>Header Separator</description>
                <left>60</left>
                <top>110</top>
                <width>1600</width>
                <height>2</height>
                <texture colordiffuse="55FFFFFF">white.png</texture>
            </control>

            <!-- Log Contents Textbox -->
            <control type="textbox" id="102">
                <description>Log Contents</description>
                <label>Log Contents</label>
                <left>80</left>
                <top>130</top>
                <width>1530</width>
                <height>730</height>
                <font>font12</font>
                <textcolor>white</textcolor>
                <align>left</align>
                <aligny>top</aligny>
                <pagecontrol>103</pagecontrol>
                <autoscroll>false</autoscroll>
            </control>

            <!-- Modern Scrollbar -->
            <control type="scrollbar" id="103">
                <description>Modern Scrollbar</description>
                <left>1630</left>
                <top>130</top>
                <width>12</width>
                <height>730</height>
                <texturesliderbackground colordiffuse="33FFFFFF">white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="FFEDC8FF">white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="FFFFFFFF">white.png</texturesliderbarfocus>
                <orientation>vertical</orientation>
                <showonepage>false</showonepage>
                <onup>103</onup>
                <ondown>103</ondown>
                <onleft>201</onleft>
                <onright>201</onright>
            </control>

            <!-- Close Button -->
            <control type="button" id="201">
                <description>Close Button</description>
                <left>730</left>
                <top>880</top>
                <width>260</width>
                <height>60</height>
                <font>font16_title</font>
                <textcolor>white</textcolor>
                <focusedcolor>black</focusedcolor>
                <label>Close</label>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus colordiffuse="FF66FF66">white.png</texturefocus>
                <texturenofocus colordiffuse="3366FF66">white.png</texturenofocus>
                <onup>103</onup>
                <ondown>201</ondown>
                <onleft>103</onleft>
                <onright>103</onright>
            </control>
        </control>
    </controls>
</window>