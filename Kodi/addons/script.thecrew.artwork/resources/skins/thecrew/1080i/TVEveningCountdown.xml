<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">5</defaultcontrol>
    <animation effect="fade" time="300">WindowOpen</animation>
    <animation effect="fade" time="300">WindowClose</animation>

    <controls>
        <!-- Full screen background with fanart -->
        <control type="image">
            <description>Background Fanart</description>
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window().Property(fanart)]</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Dark overlay for readability -->
        <control type="image">
            <description>Dark Overlay</description>
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC000000">white.png</texture>
        </control>

        <!-- Main content container -->
        <control type="group">
            <left>360</left>
            <top>120</top>

            <!-- The Crew Logo -->
            <control type="image">
                <description>The Crew Logo</description>
                <left>550</left>
                <top>0</top>
                <width>200</width>
                <height>66</height>
                <texture>icon.png</texture>
                <aspectratio aligny="center">keep</aspectratio>
            </control>

            <!-- Status Message -->
            <control type="label" id="9001">
                <description>Status Message</description>
                <left>200</left>
                <top>90</top>
                <width>800</width>
                <height>40</height>
                <font>font16</font>
                <textcolor>FFEDC8FF</textcolor>
                <align>center</align>
                <label>Preparing next episode...</label>
            </control>

            <!-- Episode Info Container -->
            <control type="group">
                <left>50</left>
                <top>150</top>

                <!-- Episode Details (no poster) -->
                <control type="group">
                    <left>0</left>
                    <top>0</top>

                    <!-- Episode Number (show + season/episode combined) -->
                    <control type="label">
                        <description>Episode Number</description>
                        <left>0</left>
                        <top>0</top>
                        <width>1100</width>
                        <height>40</height>
                        <font>font16_title</font>
                        <textcolor>FFEDC8FF</textcolor>
                        <align>left</align>
                        <label>$INFO[Window().Property(show_title)] - $INFO[Window().Property(episode_number)]</label>
                    </control>

                    <!-- Episode Title -->
                    <control type="label">
                        <description>Episode Title</description>
                        <left>0</left>
                        <top>45</top>
                        <width>1100</width>
                        <height>30</height>
                        <font>font13</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <align>left</align>
                        <label>$INFO[Window().Property(episode_title)]</label>
                    </control>

                    <!-- Episode Plot -->
                    <control type="textbox">
                        <description>Episode Plot</description>
                        <left>0</left>
                        <top>85</top>
                        <width>1100</width>
                        <height>190</height>
                        <font>font12</font>
                        <textcolor>FFAAAAAA</textcolor>
                        <align>left</align>
                        <label>$INFO[Window().Property(episode_plot)]</label>
                    </control>
                </control>
            </control>

            <!-- Cast Section -->
            <control type="group">
                <left>280</left>
                <top>420</top>
                <width>900</width>
                <height>200</height>
                <visible>!IsEmpty(Window().Property(lead1_name))</visible>

                <!-- Cast Header -->
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>900</width>
                    <height>25</height>
                    <font>font12</font>
                    <textcolor>FFAAAAAA</textcolor>
                    <align>left</align>
                    <label>STARRING</label>
                </control>

                <!-- Lead Actors Row -->
                <control type="grouplist">
                    <left>0</left>
                    <top>35</top>
                    <width>900</width>
                    <height>70</height>
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>

                    <!-- Lead 1 -->
                    <control type="group">
                        <width>280</width>
                        <height>70</height>
                        <visible>!IsEmpty(Window().Property(lead1_name))</visible>

                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>50</width>
                            <height>70</height>
                            <texture>$INFO[Window().Property(lead1_thumb)]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <control type="label">
                            <left>60</left>
                            <top>10</top>
                            <width>220</width>
                            <height>25</height>
                            <font>font12</font>
                            <textcolor>FFFFFFFF</textcolor>
                            <label>$INFO[Window().Property(lead1_name)]</label>
                        </control>

                        <control type="label">
                            <left>60</left>
                            <top>35</top>
                            <width>220</width>
                            <height>20</height>
                            <font>font10</font>
                            <textcolor>FFCCCCCC</textcolor>
                            <label>$INFO[Window().Property(lead1_character)]</label>
                        </control>
                    </control>

                    <!-- Lead 2 -->
                    <control type="group">
                        <width>280</width>
                        <height>70</height>
                        <visible>!IsEmpty(Window().Property(lead2_name))</visible>

                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>50</width>
                            <height>70</height>
                            <texture>$INFO[Window().Property(lead2_thumb)]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <control type="label">
                            <left>60</left>
                            <top>10</top>
                            <width>220</width>
                            <height>25</height>
                            <font>font12</font>
                            <textcolor>FFFFFFFF</textcolor>
                            <label>$INFO[Window().Property(lead2_name)]</label>
                        </control>

                        <control type="label">
                            <left>60</left>
                            <top>35</top>
                            <width>220</width>
                            <height>20</height>
                            <font>font10</font>
                            <textcolor>FFCCCCCC</textcolor>
                            <label>$INFO[Window().Property(lead2_character)]</label>
                        </control>
                    </control>

                    <!-- Lead 3 -->
                    <control type="group">
                        <width>280</width>
                        <height>70</height>
                        <visible>!IsEmpty(Window().Property(lead3_name))</visible>

                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>50</width>
                            <height>70</height>
                            <texture>$INFO[Window().Property(lead3_thumb)]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <control type="label">
                            <left>60</left>
                            <top>10</top>
                            <width>220</width>
                            <height>25</height>
                            <font>font12</font>
                            <textcolor>FFFFFFFF</textcolor>
                            <label>$INFO[Window().Property(lead3_name)]</label>
                        </control>

                        <control type="label">
                            <left>60</left>
                            <top>35</top>
                            <width>220</width>
                            <height>20</height>
                            <font>font10</font>
                            <textcolor>FFCCCCCC</textcolor>
                            <label>$INFO[Window().Property(lead3_character)]</label>
                        </control>
                    </control>
                </control>

                <!-- Guest Stars Header -->
                <control type="label">
                    <left>0</left>
                    <top>120</top>
                    <width>900</width>
                    <height>20</height>
                    <font>font10</font>
                    <textcolor>FF888888</textcolor>
                    <align>left</align>
                    <label>GUEST STARS</label>
                    <visible>!IsEmpty(Window().Property(guest1_name))</visible>
                </control>

                <!-- Guest Stars Row -->
                <control type="grouplist">
                    <left>0</left>
                    <top>145</top>
                    <width>900</width>
                    <height>50</height>
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>

                    <!-- Guest 1 -->
                    <control type="group">
                        <width>280</width>
                        <height>50</height>
                        <visible>!IsEmpty(Window().Property(guest1_name))</visible>

                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>35</width>
                            <height>50</height>
                            <texture>$INFO[Window().Property(guest1_thumb)]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <control type="label">
                            <left>45</left>
                            <top>5</top>
                            <width>235</width>
                            <height>20</height>
                            <font>font10</font>
                            <textcolor>FFDDDDDD</textcolor>
                            <label>$INFO[Window().Property(guest1_name)]</label>
                        </control>

                        <control type="label">
                            <left>45</left>
                            <top>25</top>
                            <width>235</width>
                            <height>18</height>
                            <font>font10</font>
                            <textcolor>FFAAAAAA</textcolor>
                            <label>$INFO[Window().Property(guest1_character)]</label>
                        </control>
                    </control>

                    <!-- Guest 2 -->
                    <control type="group">
                        <width>280</width>
                        <height>50</height>
                        <visible>!IsEmpty(Window().Property(guest2_name))</visible>

                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>35</width>
                            <height>50</height>
                            <texture>$INFO[Window().Property(guest2_thumb)]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <control type="label">
                            <left>45</left>
                            <top>5</top>
                            <width>235</width>
                            <height>20</height>
                            <font>font10</font>
                            <textcolor>FFDDDDDD</textcolor>
                            <label>$INFO[Window().Property(guest2_name)]</label>
                        </control>

                        <control type="label">
                            <left>45</left>
                            <top>25</top>
                            <width>235</width>
                            <height>18</height>
                            <font>font10</font>
                            <textcolor>FFAAAAAA</textcolor>
                            <label>$INFO[Window().Property(guest2_character)]</label>
                        </control>
                    </control>

                    <!-- Guest 3 -->
                    <control type="group">
                        <width>280</width>
                        <height>50</height>
                        <visible>!IsEmpty(Window().Property(guest3_name))</visible>

                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>35</width>
                            <height>50</height>
                            <texture>$INFO[Window().Property(guest3_thumb)]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <control type="label">
                            <left>45</left>
                            <top>5</top>
                            <width>235</width>
                            <height>20</height>
                            <font>font10</font>
                            <textcolor>FFDDDDDD</textcolor>
                            <label>$INFO[Window().Property(guest3_name)]</label>
                        </control>

                        <control type="label">
                            <left>45</left>
                            <top>25</top>
                            <width>235</width>
                            <height>18</height>
                            <font>font10</font>
                            <textcolor>FFAAAAAA</textcolor>
                            <label>$INFO[Window().Property(guest3_character)]</label>
                        </control>
                    </control>
                </control>
            </control>
            <!-- Countdown Timer -->
            <control type="label" id="9003">
                <description>Countdown Timer</description>
                <left>200</left>
                <top>630</top>
                <width>800</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>FFEDC8FF</textcolor>
                <align>center</align>
                <label>60</label>
            </control>

            <!-- Countdown Text -->
            <control type="label">
                <description>Countdown Text</description>
                <left>200</left>
                <top>680</top>
                <width>800</width>
                <height>25</height>
                <font>font12</font>
                <textcolor>FFAAAAAA</textcolor>
                <align>center</align>
                <label>seconds until next episode</label>
            </control>

            <!-- Progress Messages -->
            <control type="textbox" id="9004">
                <description>Progress Messages</description>
                <left>300</left>
                <top>720</top>
                <width>600</width>
                <height>90</height>
                <font>font12</font>
                <textcolor>FFCCCCCC</textcolor>
                <align>center</align>
                <label></label>
            </control>

            <!-- Buttons -->
            <control type="grouplist" id="5000">
                <left>315</left>
                <top>820</top>
                <width>600</width>
                <height>70</height>
                <orientation>horizontal</orientation>
                <align>center</align>
                <itemgap>30</itemgap>

                <!-- Play Now Button -->
                <control type="button" id="5">
                    <description>Play Now</description>
                    <width>270</width>
                    <height>70</height>
                    <label>Play Now</label>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <shadowcolor>FF000000</shadowcolor>
                    <disabledcolor>FF888888</disabledcolor>
                    <texturefocus border="5" colordiffuse="FFEDC8FF">white.png</texturefocus>
                    <texturenofocus border="5" colordiffuse="AA8B7AA0">white.png</texturenofocus>
                    <onup>6</onup>
                    <ondown>6</ondown>
                    <onleft>6</onleft>
                    <onright>6</onright>
                </control>

                <!-- Cancel Button -->
                <control type="button" id="6">
                    <description>Cancel Playlist</description>
                    <width>270</width>
                    <height>70</height>
                    <label>Stop Playlist</label>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <shadowcolor>FF000000</shadowcolor>
                    <disabledcolor>FF888888</disabledcolor>
                    <texturefocus border="5" colordiffuse="FFFF4444">white.png</texturefocus>
                    <texturenofocus border="5" colordiffuse="AA884444">white.png</texturenofocus>
                    <onup>5</onup>
                    <ondown>5</ondown>
                    <onleft>5</onleft>
                    <onright>5</onright>
                </control>
            </control>
        </control>
    </controls>
</window>
