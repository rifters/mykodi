<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <animation effect="fade" time="300">WindowOpen</animation>
    <animation effect="fade" time="300">WindowClose</animation>
    <controls>
        <!-- Dark overlay for readability -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
        <texture colordiffuse="88000000">white.png</texture>
        <aspectratio>scale</aspectratio>
    </control>

    <!-- Content Container with dark background -->
    <control type="group">
        <posx>1500</posx>
        <posy>0</posy>
        <width>420</width>
        <height>1080</height>

        <!-- Dark background behind content -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>420</width>
            <height>1080</height>
            <texture colordiffuse="AA000000">white.png</texture>
        </control>

        <!-- Series Poster Thumbnail -->
        <control type="image" id="50">
            <posx>20</posx>
            <posy>50</posy>
            <width>187</width>
            <height>280</height>
            <texture>$INFO[Window.Property(upnext.poster)]</texture>
            <aspectratio>keep</aspectratio>
        </control>

        <!-- Info Panel -->
        <control type="group">
            <posx>20</posx>
            <posy>350</posy>
            <width>380</width>
            <height>680</height>

                <!-- The Crew Logo -->
                <control type="image">
                    <posx>10</posx>
                    <posy>15</posy>
                    <width>50</width>
                    <height>50</height>
                    <texture>icon.png</texture>
                    <aspectratio>keep</aspectratio>
                </control>

                <!-- "Up Next" Label -->
                <control type="label">
                    <posx>70</posx>
                    <posy>15</posy>
                    <width>330</width>
                    <height>50</height>
                    <font>font30_title</font>
                    <textcolor>FFE0B0FF</textcolor>
                    <label>Up Next</label>
                    <align>left</align>
                </control>

                <!-- Show Name -->
                <control type="label" id="51">
                    <posx>0</posx>
                    <posy>70</posy>
                    <width>360</width>
                    <height>45</height>
                    <font>font25</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[Window.Property(upnext.show)]</label>
                    <align>left</align>
                </control>

                <!-- Episode Title -->
                <control type="label" id="52">
                    <posx>0</posx>
                    <posy>125</posy>
                    <width>360</width>
                    <height>40</height>
                    <font>font20</font>
                    <textcolor>FFE0B0FF</textcolor>
                    <label>$INFO[Window.Property(upnext.title)]</label>
                    <align>left</align>
                </control>

                <!-- Season/Episode Info -->
                <control type="label" id="53">
                    <posx>0</posx>
                    <posy>185</posy>
                    <width>360</width>
                    <height>40</height>
                    <font>font16</font>
                    <textcolor>FFAAAAAA</textcolor>
                    <label>Season $INFO[Window.Property(upnext.season)] • Episode $INFO[Window.Property(upnext.episode)]</label>
                    <align>left</align>
                </control>

                <!-- Countdown Timer -->
                <control type="label" id="54">
                    <posx>0</posx>
                    <posy>410</posy>
                    <width>360</width>
                    <height>100</height>
                    <font>font60_title</font>
                    <textcolor>FFE0B0FF</textcolor>
                    <label>$INFO[Window.Property(upnext.countdown)]</label>
                    <align>center</align>
                </control>

                <!-- Button Group -->
                <control type="grouplist" id="5000">
                    <posx>10</posx>
                    <posy>560</posy>
                    <width>360</width>
                    <height>70</height>
                    <orientation>horizontal</orientation>
                    <align>center</align>
                    <itemgap>20</itemgap>

                    <!-- Play Next Episode Button -->
                    <control type="button" id="100">
                        <width>160</width>
                        <height>60</height>
                        <label>Play Now</label>
                        <font>font15</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FFFFFFFF</focusedcolor>
                        <align>center</align>
                        <onleft>101</onleft>
                        <onright>101</onright>
                        <onup>101</onup>
                        <ondown>101</ondown>
                        <onclick>SetProperty(upnext.action, play)</onclick>
                        <texturefocus colordiffuse="DD9370DB">white.png</texturefocus>
                        <texturenofocus colordiffuse="6699527A">white.png</texturenofocus>
                    </control>

                    <!-- Cancel Button -->
                    <control type="button" id="101">
                        <width>160</width>
                        <height>60</height>
                        <label>Cancel</label>
                        <font>font15</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FFFFFFFF</focusedcolor>
                        <align>center</align>
                        <onleft>100</onleft>
                        <onright>100</onright>
                        <onup>100</onup>
                        <ondown>100</ondown>
                        <onclick>SetProperty(upnext.action, cancel)</onclick>
                        <texturefocus colordiffuse="DD9370DB">white.png</texturefocus>
                        <texturenofocus colordiffuse="6699527A">white.png</texturenofocus>
                    </control>
                </control>
            </control>
        </control>
    </controls>
</window>
